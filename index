function renderNav(filter=''){$('lessonNav').innerHTML='';const visible=lessons.map((l,i)=>({l,i})).filter(x=>(x.l.title+' '+x.l.short).toLowerCase().includes(filter.toLowerCase()));if(!visible.length){$('lessonNav').innerHTML='<div class="empty-search">No hay bloques con ese nombre.</div>';return;}visible.forEach(({l,i})=>{const b=document.createElement('button');b.type='button';b.className=(i===activeLesson?'active ':'')+(completed.has(l.id)?'done':'');b.innerHTML=`<span class="nav-no">${String(i+1).padStart(2,'0')}</span><span>${esc(l.short)}</span>${completed.has(l.id)?'<span class="nav-check">✓</span>':''}`;b.addEventListener('click',()=>{activeLesson=i;renderNav($('lessonSearch').value);renderLesson(i);});$('lessonNav').appendChild(b);});}
function renderLesson(i){const l=lessons[i];if(!l)return;activeLesson=i;renderNav($('lessonSearch').value);const cards=l.cards.map(c=>`<div class="content-card ${c.tone||''}"><div class="card-icon">${c.icon}</div><h3>${c.title}</h3><p>${c.text}</p></div>`).join('');const details=(l.details||[]).map(d=>`<details class="details-card"><summary>${d.title}</summary><div class="details-body">${d.body}</div></details>`).join('');const done=completed.has(l.id);$('lessonArticle').innerHTML=`<div class="lesson-topline"><span class="lesson-num">BLOQUE ${String(i+1).padStart(2,'0')} / 10 · ${l.kicker}</span><span class="pill">${done?'✓ COMPLETADO':'EN ESTUDIO'}</span></div><h2>${l.title}</h2><p class="lesson-lead">${l.lead}</p><div class="source-ref">${l.pages}</div><div class="content-grid">${cards}</div><div class="callout"><span class="callout-icon">⭐</span><div><b>Qué debes recordar:</b> ${l.note}</div></div><div class="divider"></div><div class="eyebrow">Amplía y comprende</div>${details}<div class="lesson-actions"><div class="left"><span class="complete-badge">${done?'✓ Bloque marcado como completado':'Cuando lo domines, márcalo como completado.'}</span></div><div class="right"><button class="btn btn-light" id="lessonPrev" ${i===0?'disabled':''}>← Anterior</button><button class="btn ${done?'btn-soft':'btn-primary'}" id="lessonDone">${done?'✓ Completado':'Marcar como aprendido'}</button><button class="btn btn-dark" id="lessonNext">${i===lessons.length-1?'Ir al resumen':'Siguiente →'}</button></div></div>`;
 $('lessonPrev')?.addEventListener('click',()=>{if(i>0)renderLesson(i-1);});$('lessonNext')?.addEventListener('click',()=>{if(i<lessons.length-1)renderLesson(i+1);else renderLesson(9);});$('lessonDone')?.addEventListener('click',()=>{if(completed.has(l.id)){completed.delete(l.id);}else completed.add(l.id);persist();updateProgress();renderLesson(i);renderNav($('lessonSearch').value);showToast(completed.has(l.id)?'Bloque completado ✓':'Se ha actualizado tu progreso');});}
