document.querySelectorAll('#techSwitch button').forEach(b=>b.addEventListener('click',()=>showTech(b.dataset.tech)));showTech('directa');
$('tempSlider').addEventListener('input',e=>{const v=Number(e.target.value);$('tempResult').innerHTML=`<b>${String(v).replace('.',',')} °C</b>${v>=5&&v<=6?'Estás dentro del intervalo de 5–6 °C que recoge el temario como incremento térmico de referencia.':'El dato de referencia del temario es 5–6 °C.'} Retirar la resina de la boca antes de completar su polimerización total.`;});

function renderFlash(){const f=flashcards[flashIndex];$('flashIcon').textContent=f[0];$('flashQuestion').textContent=f[1];$('flashAnswer').textContent=f[2];$('flashLabel').textContent=`IDEA CLAVE · ${flashIndex+1} DE ${flashcards.length}`;$('flashCurrent').textContent=flashIndex+1;$('flashProgress').style.width=((flashIndex+1)/flashcards.length*100)+'%';$('flashAnswer').classList.toggle('hidden',!flashRevealed);$('flashFlip').textContent=flashRevealed?'Ocultar respuesta':'Ver respuesta';}
function flipFlash(){flashRevealed=!flashRevealed;renderFlash();}function nextFlash(dir){flashIndex=(flashIndex+dir+flashcards.length)%flashcards.length;flashRevealed=false;renderFlash();}
$('flashCard').addEventListener('click',flipFlash);$('flashCard').addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();flipFlash();}});$('flashFlip').addEventListener('click',flipFlash);$('flashPrev').addEventListener('click',()=>nextFlash(-1));$('flashNext').addEventListener('click',()=>nextFlash(1));renderFlash();

function shuffle(a){const x=[...a];for(let i=x.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[x[i],x[j]]=[x[j],x[i]];}return x;}
function startQuiz(list=null){quizOrder=shuffle(list||questions);quizIndex=0;quizScore=0;quizCorrect=0;quizWrong=[];quizAnswered=false;$('quizResult').classList.add('hidden');$('quizArea').classList.remove('hidden');$('quizPoints').textContent='0';$('quizCorrect').textContent='0';go('quiz');renderQuestion();}
function renderQuestion(){currentQuestion=quizOrder[quizIndex];quizAnswered=false;const q=currentQuestion;const options=shuffle(q.a.map((text,i)=>({text,correct:i===q.correct})));currentQuestion._options=options;$('quizIndex').textContent=`Pregunta ${quizIndex+1}/${quizOrder.length}`;$('quizTopic').textContent=q.topic;$('quizTopicBig').textContent=q.topic.toUpperCase();$('quizQuestion').textContent=q.q;$('quizProgress').style.width=((quizIndex)/quizOrder.length*100)+'%';$('quizFeedback').className='quiz-feedback';$('quizFeedback').innerHTML='';$('quizNext').disabled=true;$('quizNext').textContent=quizIndex===quizOrder.length-1?'Ver resultados →':'Siguiente pregunta →';$('quizSkip').disabled=false;$('quizAnswers').innerHTML='';options.forEach((o,i)=>{const b=document.createElement('button');b.type='button';b.className='quiz-answer';b.innerHTML=`<span class="answer-letter">${String.fromCharCode(65+i)}</span><span>${esc(o.text)}</span>`;b.addEventListener('click',()=>answerQuestion(i));$('quizAnswers').appendChild(b);});}
function answerQuestion(i){if(quizAnswered)return;quizAnswered=true;const q=currentQuestion,selected=q._options[i],good=selected.correct;const btns=[...$('quizAnswers').querySelectorAll('button')];btns.forEach((b,j)=>{b.disabled=true;if(q._options[j].correct)b.classList.add('correct');else if(j===i)b.classList.add('wrong');else b.classList.add('dim');});const fb=$('quizFeedback');fb.className='quiz-feedback show '+(good?'good':'bad');fb.innerHTML=`<b>${good?'¡Muy bien! +10 puntos':'Vamos a fijar la idea'}</b>${esc(q.why)}`;if(good){quizCorrect++;quizScore+=10;}else quizWrong.push({q,selected:selected.text});$('quizPoints').textContent=quizScore;$('quizCorrect').textContent=quizCorrect;$('quizSkip').disabled=true;$('quizNext').disabled=false;}
function skipQuestion(){if(quizAnswered)return;quizAnswered=true;quizWrong.push({q:currentQuestion,selected:null});const q=currentQuestion;[...$('quizAnswers').querySelectorAll('button')].forEach((b,j)=>{b.disabled=true;if(q._options[j].correct)b.classList.add('correct');else b.classList.add('dim');});$('quizFeedback').className='quiz-feedback show bad';$('quizFeedback').innerHTML=`<b>La dejamos para el repaso</b>${esc(q.why)}`;$('quizSkip').disabled=true;$('quizNext').disabled=false;}
$('quizAnswers').addEventListener('click',()=>{});$('quizSkip').addEventListener('click',skipQuestion);$('quizNext').addEventListener('click',()=>{if(!quizAnswered)return;if(quizIndex<quizOrder.length-1){quizIndex++;renderQuestion();}else finishQuiz();});
function finishQuiz(){$('quizArea').classList.add('hidden');$('quizResult').classList.remove('hidden');const total=quizOrder.length,p=Math.round(quizCorrect/total*100);$('resultPercent').textContent=p+'%';$('resultGood').textContent=quizCorrect;$('resultBad').textContent=quizWrong.length;$('resultPoints').textContent=quizScore;$('quizProgress').style.width='100%';const list=$('quizReview');list.innerHTML='';if(!quizWrong.length)list.innerHTML='<div class="callout"><span class="callout-icon">🌟</span><div>¡Partida limpia! Has respondido correctamente todas las preguntas.</div></div>';quizWrong.forEach((it,i)=>{const row=document.createElement('div');row.className='review-row';row.innerHTML=`<b>${i+1}. ${esc(it.q.q)}</b><span>Tu respuesta: ${it.selected===null?'Sin contestar':esc(it.selected)}</span><span class="correct-text">Explicación: ${esc(it.q.why)}</span>`;list.appendChild(row);});$('retryWrong').disabled=!quizWrong.length;}
$('retryWrong').addEventListener('click',()=>startQuiz(quizWrong.map(x=>x.q)));$('quizAgain').addEventListener('click',()=>startQuiz());

renderNav();updateProgress();renderLesson(0);
</script>
