function go(view){document.querySelectorAll('.view').forEach(v=>v.classList.toggle('active',v.id==='view-'+view));document.querySelectorAll('#mainNav button').forEach(b=>b.classList.toggle('active',b.dataset.go===view));window.scrollTo({top:0,behavior:'smooth'});if(view==='learn')renderLesson(activeLesson);if(view==='quiz'&&(quizOrder.length===0||!$('quizResult').classList.contains('hidden')))startQuiz();}
